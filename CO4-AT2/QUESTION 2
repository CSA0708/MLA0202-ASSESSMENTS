import numpy as np
from hmmlearn import hmm

states = ["Healthy", "Warning", "Failure"]
observations = ["Low", "Medium", "High"]

model = hmm.CategoricalHMM(
    n_components=3,
    random_state=42
)

model.startprob_ = np.array([
    0.70,
    0.20,
    0.10
])

model.transmat_ = np.array([
    [0.80, 0.18, 0.02],
    [0.15, 0.70, 0.15],
    [0.02, 0.18, 0.80]
])

model.emissionprob_ = np.array([
    [0.80, 0.18, 0.02],
    [0.15, 0.65, 0.20],
    [0.02, 0.18, 0.80]
])

sensor_sequence = np.array([
    [0],
    [0],
    [1],
    [1],
    [2],
    [2]
])

log_probability, hidden_states = model.decode(
    sensor_sequence,
    algorithm="viterbi"
)

print("Sensor Observations:")
print([
    observations[x[0]]
    for x in sensor_sequence
])

print("\nPredicted Hidden States:")

for i, state in enumerate(hidden_states):
    print(
        observations[sensor_sequence[i][0]],
        "->",
        states[state]
    )

print("\nLog Probability:", log_probability)

current_state = states[hidden_states[-1]]

print("\nCurrent Machine State:", current_state)

if current_state == "Healthy":
    print("Maintenance Status: Normal operation.")
elif current_state == "Warning":
    print("Maintenance Status: Schedule preventive maintenance.")
else:
    print("Maintenance Status: Immediate maintenance required.")
