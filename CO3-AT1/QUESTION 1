import pandas as pd
import matplotlib.pyplot as plt
import ssl
import urllib.request
from io import BytesIO

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score


url = "https://raw.githubusercontent.com/anujvyas/Machine-Learning-Projects/master/Mall%20Customer%20Segmentation/Mall_Customers.csv"

ssl_context = ssl._create_unverified_context()

print("Loading Mall Customers dataset...")

try:
    response = urllib.request.urlopen(url, context=ssl_context)
    data = pd.read_csv(BytesIO(response.read()))

    print("Dataset loaded successfully!")
    print("Number of customers:", len(data))
    print()

except Exception as e:
    print("Error loading dataset.")
    print(e)
    exit()

X = data[
    [
        "Age",
        "Annual Income (k$)",
        "Spending Score (1-100)"
    ]
]


scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print("Data preprocessing completed!")
print()
inertia = []

for k in range(2, 11):

    model = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    model.fit(X_scaled)

    inertia.append(model.inertia_)


plt.figure(figsize=(7, 5))

plt.plot(
    range(2, 11),
    inertia,
    marker="o"
)

plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")

plt.show()
kmeans = KMeans(
    n_clusters=5,
    random_state=42,
    n_init=10
)

clusters = kmeans.fit_predict(X_scaled)
score = silhouette_score(
    X_scaled,
    clusters
)
print("Number of Clusters:", 5)
print("Silhouette Score:", round(score, 3))
print()
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
plt.figure(figsize=(8, 6))
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=clusters,
    s=50
)
plt.xlabel("PCA Component 1")
plt.ylabel("PCA Component 2")
plt.title(
    "Customer Segmentation using K-Means and PCA"
)
plt.show()
print("---------------------------------------")
print("EXPERIMENT COMPLETED SUCCESSFULLY")
print("---------------------------------------")
print("Algorithm: K-Means")
print("Number of Clusters: 5")
print("Dimensionality Reduction: PCA")
print("PCA Components: 2")
print("Silhouette Score:", round(score, 3))
