from sklearn.datasets import load_digits
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score, adjusted_rand_score
import matplotlib.pyplot as plt
digits = load_digits()
X = digits.data
y = digits.target
X = StandardScaler().fit_transform(X)
kmeans = KMeans(n_clusters=10, random_state=42, n_init=10)
k_labels = kmeans.fit_predict(X)
gmm = GaussianMixture(n_components=10, random_state=42)
g_labels = gmm.fit_predict(X)
print("K-Means Silhouette Score:",
      silhouette_score(X, k_labels))
print("GMM Silhouette Score:",
      silhouette_score(X, g_labels))

print("K-Means ARI:",
      adjusted_rand_score(y, k_labels))
print("GMM ARI:",
      adjusted_rand_score(y, g_labels))
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=k_labels, s=10)
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.title("K-Means Clustering of Digits")
plt.show()
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=g_labels, s=10)
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.title("GMM Clustering using EM Algorithm")
plt.show()
print("K-Means and GMM clustering completed successfully.")
